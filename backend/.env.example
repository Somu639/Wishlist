GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.6-27b
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=
SQLITE_PATH=

# Photoreal virtual try-on. Never uses Groq for image generation.
# Works with no configuration: it defaults to the free Hugging Face IDM-VTON
# Space. Set FAL_KEY (https://fal.ai/dashboard/keys) for a faster paid engine;
# if that key is rejected or out of credit it falls back to the free Space.
FAL_KEY=
# Optional free token from https://huggingface.co/settings/tokens.
# Raises the shared-GPU quota on the free Space.
HF_TOKEN=
# fal | huggingface | http | none. Unset auto-selects fal when FAL_KEY is set.
# VTON_PROVIDER=
# VTON_HF_SPACE=https://yisol-idm-vton.hf.space
# VTON_MODEL=fal-ai/fashn/tryon/v1.6
# performance | balanced | quality
# VTON_MODE=balanced

# Generic vendor adapter, used when VTON_PROVIDER=http
# VTON_API_URL=https://your-vton-vendor.example/v1/try-on
# VTON_API_KEY=
# VTON_PROVIDER_NAME=fashn
