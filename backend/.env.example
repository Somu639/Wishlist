GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.6-27b
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=
SQLITE_PATH=

# Photoreal virtual try-on. Optional, and never uses Groq for image generation.
# Set FAL_KEY (https://fal.ai/dashboard/keys) and try-on turns on automatically.
# Without it the app falls back to the browser-side style preview.
FAL_KEY=
# fal | http | none. Leave unset to auto-select fal when FAL_KEY is present.
# VTON_PROVIDER=fal
# VTON_MODEL=fal-ai/fashn/tryon/v1.6
# performance | balanced | quality
# VTON_MODE=balanced

# Generic vendor adapter, used when VTON_PROVIDER=http
# VTON_API_URL=https://your-vton-vendor.example/v1/try-on
# VTON_API_KEY=
# VTON_PROVIDER_NAME=fashn
