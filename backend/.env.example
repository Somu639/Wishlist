GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.6-27b
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Virtual try-on is optional and never uses Groq for image generation.
# none = V1 fallback (AI Style Recommendation)
# http = POST to VTON_API_URL with { user_image, product_image, product_metadata }
VTON_PROVIDER=none
# VTON_API_URL=https://your-vton-vendor.example/v1/try-on
# VTON_API_KEY=
# VTON_PROVIDER_NAME=fashn
